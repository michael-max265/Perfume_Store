# EmailJS Configuration
# Follow these steps to set up email sending:

# 1. Sign up for free at https://www.emailjs.com/
# 2. Once logged in, go to Account > API Keys (or dashboard.emailjs.com)
# 3. Copy your PUBLIC KEY
VITE_EMAILJS_PUBLIC_KEY=RrmEUJAYAFkEDE6dG
# 4. Create an Email Service:
#    - Click "Add Service"
#    - Choose "Gmail" or any email provider
#    - Grant access and name it (e.g., "gmail_service")
#    - Copy the Service ID
VITE_EMAILJS_SERVICE_ID=service_7ewymsv

# 5. Create an Email Template:
#    - Go to Email Templates
#    - Click "Create New Template"
#    - Use these variables in your template:
#      {{from_name}} - Customer name
#      {{from_email}} - Customer email
#      {{subject}} - Contact subject
#      {{message}} - Contact message
#      {{to_email}} - Your email (recipient)
#    - Copy the Template ID
VITE_EMAILJS_TEMPLATE_ID=template_w3rkqjs

# 6. Your receiving email address (must match your EmailJS setup)
VITE_RECEIVER_EMAIL=okparachukwukamichael@gmail.com
